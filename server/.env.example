# Copie este arquivo para .env e preencha. Nunca faça commit do .env.

# --- Servidor ---
PORT=3000
# Origem permitida para a plataforma (ex.: https://seu-usuario.github.io). "*" libera qualquer origem.
CORS_ORIGIN=*
# Chave exigida pelas rotas da API (header x-api-key). Deixe vazio para desligar.
# Prefira API_KEY_HASH (só o hash scrypt; gere com: printf %s "chave" | npm run --silent segredos -- hash-chave).
# Use API_KEY ou API_KEY_HASH, não os dois. API_KEY também aceita o formato cifrado enc:v1:...
API_KEY=
API_KEY_HASH=

# --- Segurança ---
# Chave-mestra para decifrar valores "enc:v1:..." (JENKINS_TOKEN, GITHUB_TOKEN, JIRA_TOKEN, API_KEY).
# Gere com: npm run segredos -- gerar-chave ~/.qa-ai-agent.key  (arquivo fora do repositório, permissão 600)
# Cifre cada segredo com: printf %s "$TOKEN" | npm run --silent segredos -- cifrar
SECRETS_KEY_FILE=
# HTTPS nativo (opcional; ou use um proxy reverso com TLS)
TLS_CERT_FILE=
TLS_KEY_FILE=
# true = confia no X-Forwarded-For (só atrás de proxy seu) para o bloqueio de tentativas por IP
TRUST_PROXY=false
# Bloqueio: falhas de chave por IP dentro da janela (ms) antes de responder 429
AUTH_MAX_FAILS=10
AUTH_FAIL_WINDOW_MS=300000
# Validade do tíquete do SSE (ms) e máximo de conexões em tempo real
TICKET_TTL_MS=30000
MAX_SSE_CLIENTS=200
# Compatibilidade (deixe false): aceitar ?key= na URL; aceitar Jenkins/Jira/GitHub por http:// em rede interna confiável
ALLOW_URL_KEY=false
ALLOW_INSECURE_UPSTREAM=false
# true = gera execuções fictícias, sem precisar de Jenkins nem de GitHub
DEMO=false

# --- Jenkins (Basic Auth com usuário + API token) ---
JENKINS_URL=https://jenkins.suaempresa.com
JENKINS_USER=seu.usuario
JENKINS_TOKEN=
# Jobs a acompanhar, separados por vírgula. Jobs dentro de pastas: Pasta/SubPasta/Job
JENKINS_JOBS=E-commerce/Checkout,E-commerce/Pagamento,Cliente/Cadastro
# Intervalo de leitura do log de um build em andamento (ms)
POLL_MS=3000
# Intervalo para descobrir builds novos (ms)
DISCOVER_MS=30000
# Opcional: regex própria para as linhas de resultado do log.
# Grupos nomeados: status, name, dur (opcional) e unit (ms|s|m, opcional)
# LOG_REGEX=^\s*(?<status>PASS|FAIL)\s+(?<name>.+?)\s+(?<dur>\d+)(?<unit>ms)$
# Opcional: regex para o tempo de resposta. Grupos: name, ms
# RESP_REGEX=\[resp\]\s+(?<name>.+?)\s+(?<ms>\d+)\s*ms

# --- GitHub Actions (token + workflows a acompanhar; pode usar junto com o Jenkins) ---
# Token: fine-grained com permissão Actions (leitura) e Metadata (leitura). Para Executar/Parar, Actions (escrita)
GITHUB_TOKEN=
# GitHub Enterprise Server: https://github.suaempresa.com/api/v3
GITHUB_API_URL=https://api.github.com
# dono/repositório/arquivo.yml acompanha um workflow · dono/repositório acompanha todos os workflows do repositório
GITHUB_WORKFLOWS=suaempresa/loja/e2e.yml,suaempresa/app
# Intervalo de leitura de um run em andamento (ms) e de busca de runs novos (ms)
GITHUB_POLL_MS=10000
GITHUB_DISCOVER_MS=30000
# Opcional: só baixa o log dos jobs cujo nome casa com a expressão (cada log custa 1 chamada)
# GITHUB_LOG_JOBS=e2e|teste

# --- Jira (Cloud: e-mail + API token; Server/Data Center: usuário + token pessoal) ---
JIRA_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=voce@suaempresa.com
JIRA_TOKEN=
JIRA_PROJECT=QA
# 3 = Jira Cloud · 2 = Jira Server/Data Center
JIRA_API_VERSION=3
# true = abre (ou comenta) um bug para cada cenário que falhar
JIRA_AUTO_BUG=false
JIRA_ISSUE_TYPE=Bug
JIRA_LABELS=qa-ai-agent
# Consulta (JQL) usada na API do Jira para buscar os cenários de teste
JIRA_SCENARIOS_JQL=project = QA AND issuetype = Test ORDER BY key
# Campo do Jira que indica o componente/pipeline do cenário: components, labels ou customfield_xxxxx
JIRA_PIPELINE_FIELD=components
# basic = e-mail/usuário + token · bearer = token pessoal (PAT) do Jira Data Center
JIRA_AUTH=basic

# --- Sincronização do Jira (a tela lê o cache do servidor; o Jira recebe sempre as mesmas chamadas) ---
# Intervalo da sincronização (ms). 0 desliga. Só as issues alteradas são lidas a cada rodada
JIRA_SYNC_MS=300000
# Rodada completa (todos os cenários) a cada N ms
JIRA_FULL_SYNC_MS=21600000
# Depois de cada build, relê os ciclos ativos após N ms (dá tempo do Zephyr receber os resultados). 0 desliga
JIRA_AFTER_BUILD_MS=20000
# Pausa entre chamadas seguidas ao Jira/Zephyr (ms)
JIRA_GAP_MS=200
# Intervalo mínimo entre duas atualizações manuais (botão Atualizar do Jira)
JIRA_MIN_MANUAL_MS=30000

# --- Zephyr Scale (Server/Data Center): ciclos de teste, pela API ATM do próprio Jira ---
# Usa o mesmo JIRA_URL e a mesma autenticação. Confirme os caminhos no seu ambiente (docs/CONTRATOS.md)
ZEPHYR=false
ZEPHYR_API_PATH=/rest/atm/1.0
# Opcional: TQL para escolher os ciclos. Padrão: projectKey = "<JIRA_PROJECT>"
# ZEPHYR_TQL=projectKey = "QA" AND folder = "/Regressão"
# Campo da issue do cenário com a chave do caso (PROJ-T123). Vazio = procura no título e nos labels
# ZEPHYR_CASE_FIELD=customfield_10200
# Quantos ciclos acompanhar, por quantos dias um ciclo sem alteração é "ativo" e quais status encerram o ciclo
ZEPHYR_MAX_CYCLES=100
ZEPHYR_ACTIVE_DAYS=30
ZEPHYR_CLOSED_STATUS=Done
# Opcional: endereço do ciclo no Jira. {jira} e {key} são trocados pelos valores reais
# ZEPHYR_CYCLE_URL={jira}/secure/Tests.jspa#/testPlayer/{key}

# --- Proteção contra limite de requisições (429/503) ---
# Repetições por chamada, espera inicial e espera máxima (ms). O Retry-After do servidor tem prioridade
HTTP_RETRIES=3
HTTP_BACKOFF_MS=1000
HTTP_MAX_WAIT_MS=60000
# Estágios do Jenkins são lidos a cada N leituras do log
STAGES_EVERY=3
# Leituras seguidas com erro passageiro antes de dar o build como falha
TRACK_MAX_ERRORS=5
# Máximo de builds acompanhados ao mesmo tempo
MAX_TRACKED_BUILDS=10
